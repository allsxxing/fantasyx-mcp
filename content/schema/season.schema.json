{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "season.schema.json",
  "title": "Season",
  "type": "object",
  "additionalProperties": true,
  "required": ["season", "league_id", "status"],
  "properties": {
    "season": { "type": "string" },
    "league_id": { "type": "string" },
    "previous_league_id": { "type": ["string", "null"] },
    "draft_id": { "type": ["string", "null"] },
    "status": { "type": "string", "enum": ["complete", "in_season", "upcoming"] },
    "champion": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "roster_id": { "type": ["number", "string"] },
        "user_id": { "type": ["string", "null"] },
        "display_name": { "type": ["string", "null"] },
        "team_name": { "type": ["string", "null"] },
        "source": { "type": "string" }
      }
    },
    "source": { "type": "string" },
    "standings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["rank", "roster_id", "wins", "losses"],
        "properties": {
          "rank": { "type": "number" },
          "roster_id": { "type": "number" },
          "user_id": { "type": ["string", "null"] },
          "display_name": { "type": ["string", "null"] },
          "team_name": { "type": ["string", "null"] },
          "wins": { "type": "number" },
          "losses": { "type": "number" },
          "ties": { "type": "number" },
          "points_for": { "type": ["number", "null"] },
          "points_against": { "type": ["number", "null"] }
        }
      }
    },
    "matchups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["week", "final", "games"],
        "properties": {
          "week": { "type": "number" },
          "final": { "type": "boolean" },
          "games": { "type": "array" }
        }
      }
    }
  }
}
