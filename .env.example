# FantasyX-MCP environment — variable NAMES only. Never commit real values.
# The public endpoint (/api/mcp) needs none of these; Sleeper's read API is public.
# Set them in Vercel (Production) or in the Claude Code cloud environment's secret settings.

# --- App (src/) ---
# Bearer token gating /api/admin/mcp. Generate: openssl rand -hex 32
FANTASYX_ADMIN_TOKEN=
# Bearer token gating /api/grok/mcp. Generate: openssl rand -hex 32
FANTASYX_GROK_TOKEN=
# Private league data JSON (dues status, contacts) read only by the admin endpoint.
# Example shape (do not put real data in this file):
# {"dues_status":[{"user_id":"...","paid":false}],"contacts":[{"user_id":"...","handle":"..."}]}
FANTASYX_PRIVATE_DATA=
# Comma-separated allowlist of proxied tool names for /api/grok/mcp; empty = all.
GROK_TOOL_ALLOWLIST=
# Kill switches — proxied tools only register when the matching var is exactly "true".
# Set to exactly "true" to register the Flaim proxy tools on /api/grok/mcp.
FLAIM_ENABLED=
# Set to exactly "true" to register the FantasyPros proxy tools on /api/grok/mcp.
FANTASYPROS_ENABLED=
# Flaim OAuth client id, minted via: node scripts/oauth-bootstrap.mjs flaim
FLAIM_CLIENT_ID=
# Flaim OAuth refresh token, minted via: node scripts/oauth-bootstrap.mjs flaim
FLAIM_REFRESH_TOKEN=
# FantasyPros OAuth client id, minted via: node scripts/oauth-bootstrap.mjs fantasypros
FANTASYPROS_CLIENT_ID=
# FantasyPros OAuth refresh token, minted via: node scripts/oauth-bootstrap.mjs fantasypros
FANTASYPROS_REFRESH_TOKEN=
# Opt-in live scores endpoint /api/live/mcp. Must be exactly "1" or the route returns 404.
# Any other value (including empty) leaves it off. The public /api/mcp endpoint does not read this.
FANTASYX_LIVE=
# Bearer token required by /api/live/mcp when the flag is on. Generate: openssl rand -hex 32
FANTASYX_LIVE_TOKEN=

# --- Scripts (scripts/) ---
# Google service-account key JSON used by sync-calendar.mjs.
GCAL_SA_KEY=
# Target Google Calendar id used by sync-calendar.mjs.
GCAL_CALENDAR_ID=
# Optional override for the current league id used by sync-sleeper.mjs.
# FANTASYX_LEAGUE_2026=1370188155843526656
# Source rules corpus location read by import-icloud.mjs.
FANTASYX_CORPUS=
# Set to make sync-calendar.mjs preview changes without writing to the calendar.
DRY_RUN=
