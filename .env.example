# FantasyX-MCP environment
#
# The public endpoint (/api/mcp) needs NONE of these — Sleeper's read API is public.
# These gate the admin endpoint (/api/mcp/admin) and supply private league data.
# Set them in Vercel as Production env vars; never commit real values.

# Bearer token required by /api/mcp/admin. Generate: openssl rand -hex 32
FANTASYX_ADMIN_TOKEN=

# Private league data as JSON — payment handles, contacts, dues paid/unpaid list.
# Read ONLY by the admin endpoint. Example shape (do not put real data in this file):
# {"dues_status":[{"user_id":"...","paid":false}],"contacts":[{"user_id":"...","handle":"..."}]}
FANTASYX_PRIVATE_DATA=

# Optional override for the current (upcoming) league id used by sync-sleeper.mjs
# FANTASYX_LEAGUE_2026=1370188155843526656
