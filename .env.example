# FantasyX-MCP environment
#
# The public endpoint (/api/mcp) needs NONE of these — Sleeper's read API is public.
# These gate the admin endpoint (/api/admin/mcp) and supply private league data.
# Set them in Vercel as Production env vars; never commit real values.

# Bearer token required by /api/admin/mcp. Generate: openssl rand -hex 32
FANTASYX_ADMIN_TOKEN=

# Private league data as JSON — payment handles, contacts, dues paid/unpaid list.
# Read ONLY by the admin endpoint. Example shape (do not put real data in this file):
# {"dues_status":[{"user_id":"...","paid":false}],"contacts":[{"user_id":"...","handle":"..."}]}
FANTASYX_PRIVATE_DATA=

# Optional override for the current (upcoming) league id used by sync-sleeper.mjs
# FANTASYX_LEAGUE_2026=1370188155843526656

# --- Grok bridge endpoint (/api/grok/mcp) — personal use, bearer-gated ---
# Bearer token required by /api/grok/mcp. Generate: openssl rand -hex 32
FANTASYX_GROK_TOKEN=

# Kill switches — proxied tools only register when the matching var is exactly "true".
# FLAIM_ENABLED=true
# FANTASYPROS_ENABLED=true

# Comma-separated allowlist of registered tool names (e.g. "flaim__get_user_session,fp__get_leagues").
# Leave unset to register every tool in the upstream's snapshot.
# GROK_TOOL_ALLOWLIST=

# Personal OAuth credentials for each upstream, minted once via:
#   node scripts/oauth-bootstrap.mjs flaim
#   node scripts/oauth-bootstrap.mjs fantasypros
# NEVER commit real values — these authenticate as the commissioner's own upstream account.
# These are only the SEED value used on first refresh. FantasyPros rotates its refresh token on
# every use (confirmed empirically); the live value is then persisted in Redis (see below) and
# these env vars are no longer read once that happens.
FLAIM_CLIENT_ID=
FLAIM_REFRESH_TOKEN=
FANTASYPROS_CLIENT_ID=
FANTASYPROS_REFRESH_TOKEN=

# Upstash Redis (Vercel Marketplace: `vercel integration add upstash`) — persists the current
# refresh token across stateless invocations for upstreams that rotate it on use. Auto-populated
# by the integration; set manually only for local dev against the same database.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
